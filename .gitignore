# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/

# A4 실측용 임시 스냅샷 — Tailwind 소스 스캔에서도 빠져야 한다
# (스냅샷 HTML 속 RSC 스크립트 조각을 클래스로 오인해 CSS 컴파일이 깨진 적 있음)
/public/_a4/
*.tmp.ts
