generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── 테넌트(아파트 단지) ──────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String // 단지명
  address             String?
  zipcode             String? // 우편번호 — 내용증명 우체국 수신인 목록에 쓴다
  phone               String? // 관리사무소 대표번호 — 공고문 하단 TEL
  fax                 String?
  households          Int? // 세대수
  buildingInfo        String? // 동 구성 설명 (예: "101동~110동")
  approvalLine        Json? // 결재선: 결재 순서대로 userId 배열
  /// 직원이 아닌 외부 결재자(입주자대표회장·감사): [{ role: "CHAIR"|"AUDITOR", name, phone?, email? }]
  /// User로 만들지 않는 이유 — 회장은 로그인하지 않고, 계정을 만들면 RBAC·직원 관리가 오염된다.
  externalApprovers   Json?
  /// 관리규약이 정한 관리소장 전결 한도(VAT 제외, 원). 이 금액 이하이고 예산에 반영된
  /// 집행이면 입주자대표회의(회장) 결재 없이 진행한다. null = 규약 확인 전이라 적용 안 함.
  /// 단지마다 다른 유일한 결재선 변수라 값으로 받는다 — 규약 원문 해석은 코드가 하지 않는다.
  directorLimit       Int?
  /// 전결 근거가 되는 관리규약 조항 (예: "제38조(관리소장의 전결사항)").
  /// 전결로 처리한 문서의 관련근거에 그대로 인용한다 — 사용자가 적은 값이라 조항을 지어낼 일이 없다.
  directorLimitClause String?
  /// 직인 이미지 (data URI). 파일 스토리지가 없어 DB에 직접 저장 — 도장 이미지는 수십 KB라 충분하다
  sealImage           String?
  /// 아파트 로고 (data URI, 직인과 같은 방식) — 공고문 하단 단지명 앞에 찍힌다
  logoImage           String?
  /// 셀프 탈퇴 요청 시각. 여기서 30일(GRACE) 뒤 크론이 실제로 지운다.
  /// 즉시 지우면 홧김에 누른 한 번으로 법정 보존 대상 문서까지 사라진다.
  /// 유예 동안은 그대로 쓸 수 있고 언제든 취소할 수 있다.
  deleteRequestedAt   DateTime?
  memo                String? // 관리자 전용 메모 (영업·CS 기록, 사용자에게 노출 안 됨)
  status              TenantStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())

  users          User[]
  modules        TenantModule[]
  documents      Document[]
  notifications  Notification[]
  units          Unit[]
  inquiries      Inquiry[]
  billing        Billing?
  dunningEntries DunningEntry[]
  trainingStaff  TrainingStaff[]
}

// ── 결제 (토스페이먼츠 자동결제) ─────────────────────────────

/// 단지의 결제 수단과 청구 주기. Tenant에 컬럼으로 붙이지 않은 이유는
/// Tenant.status(이용 중지)와 결제 상태가 서로 다른 뜻인데 이름이 겹치기 때문이다.
model Billing {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// 토스에 넘기는 고객 식별자. 단지 id를 그대로 쓰지 않는다 —
  /// 빌링키는 customerKey와 쌍으로만 결제되므로 추측 가능한 값이면 안 된다.
  customerKey String        @unique
  billingKey  String? // 카드 정보 대신 저장하는 키. 카드번호는 우리가 갖지 않는다
  cardCompany String?
  cardNumber  String? // 토스가 마스킹해서 주는 값 (예: "43301234****123*")
  status      BillingStatus @default(NONE)

  /// 다음 청구일(KST 그날 00:00). null = 청구할 게 없음(카드 미등록 또는 전 모듈 해지)
  nextBillingAt     DateTime?
  /// 청구 기준일(1~31). 매달 +1개월로 계산하면 1/31 → 2/28 → 3/28처럼 날짜가 앞으로 밀린다.
  /// 기준일을 따로 들고 그 달 말일로 잘라 쓰면 31일 가입자도 계속 말일에 청구된다.
  billingDay        Int?
  /// 결제 실패로 PAST_DUE가 된 시각 — 여기서 유예 7일과 재시도(D+3·D+7)를 센다
  pastDueSince      DateTime?
  /// 기간 말 해지 예약. 이미 낸 달은 끝까지 쓰게 하고 다음 청구일에 실제로 끊는다
  cancelRequestedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([nextBillingAt])
}

enum BillingStatus {
  NONE /// 카드 미등록
  ACTIVE /// 정상 — 체험이 끝나도 잠기지 않고 청구된다
  PAST_DUE /// 결제 실패, 유예 중 — 서비스는 계속 쓸 수 있다
  SUSPENDED /// 유예 초과 — 전 모듈 잠금, 셀프 재결제로 풀린다
}

/// 청구 이력. items에 **가격 스냅샷**을 남겨서, 모듈 가격이 바뀌어도
/// 과거 청구 내역이 소급되어 달라지지 않게 한다.
model Payment {
  id       String @id @default(cuid())
  /// 단지 id — 일부러 FK를 걸지 않는다. 결제 기록은 회계 증빙(세무·분쟁 근거)이라
  /// 단지 탈퇴(purge)가 Billing·Tenant를 지운 뒤에도 남아야 한다. FK가 있으면
  /// cascade로 함께 지워지거나(증빙 소실) 부모 삭제가 막힌다.
  tenantId String

  orderId String        @unique // 토스 주문번호 — 재시도마다 새로 만든다
  amount  Int
  status  PaymentStatus
  /// [{ moduleId, name, price }] — 청구 시점의 모듈 구성과 가격
  items   Json

  periodStart DateTime
  periodEnd   DateTime

  paymentKey String?
  receiptUrl String?
  failCode   String?
  failReason String?
  /// 유예 시작(pastDueSince)부터 며칠째 시도인가 — 최초·연체 없는 결제는 1.
  /// (재시도는 유예 안에서 매일 돈다 — 옛 D+3/D+7 회차 정책이 아니다)
  attempt    Int     @default(1)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([tenantId, createdAt])
}

enum PaymentStatus {
  PENDING // 토스 호출 전에 먼저 적는 자리 — 죽어도 주문번호가 남아 대사가 가능하다
  PAID
  FAILED
}

// ── 세대 마스터 (모든 모듈이 공유: 독촉장, 민원, 공지 발송 등) ──

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  dong      String // "101"
  ho        String // "502"
  name      String? // 세대주/입주민 (선택)
  phone     String? // 연락처 (선택)
  createdAt DateTime @default(now())

  @@unique([tenantId, dong, ho])
}

// ── 미납 독촉 발송 이력 ──────────────────────────────────────
// 발송 1건 = 세대 1행. 회차 문서(Document)는 불변 스냅숏이고,
// 납부 확인(paidAt)처럼 나중에 바뀌는 상태는 여기에만 찍는다.
model DunningEntry {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  docId     String // 소속 발송 회차 (type: dunning_letter)
  document  Document  @relation(fields: [docId], references: [id], onDelete: Cascade)
  dong      String // "101"
  ho        String // "502"
  name      String? // 엑셀에 없으면 세대명부(Unit)에서 채움
  amount    Int // 미납액(원)
  /// 미납 기간 자유 텍스트 ("2026년 3월분 ~ 6월분") — 회계 프로그램마다
  /// export 형식이 제각각이라 구조화(시작월·종료월)는 파싱 실패만 만든다
  period    String?
  stage     Int // 1 납부 안내 · 2 납부 최고 · 3 내용증명
  paidAt    DateTime? // 납부 확인 시각 — 다음 회차 단계 제안이 이 값을 본다
  /// 법적 절차(지급명령 등) 진행 표시 — 3차 이후를 구분만 한다(별도 모듈 없음).
  /// 미납 목록에서 따로 묶이고 발송 대상 선택에서 빠진다.
  legalAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, dong, ho])
  @@index([docId])
}

// ── 산업안전보건 교육일지 — 모듈 전용 직원 명부 ──────────────
// 앱 계정(User)과 연결하지 않는다: 교육 대상 대부분(기전·경비·미화)이 계정이 없다.
// 완성된 일지에는 meta.attendees 스냅샷으로 남으므로 여기를 고쳐도 지난 증빙은 불변.
model TrainingStaff {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  position  String // 직종: 사무·기전·경비·미화·기타 (src/lib/safety-training.ts STAFF_POSITIONS)
  office    Boolean  @default(false) // 사무직 여부 — 정기교육 법정 시간이 갈린다(반기 6h/12h)
  active    Boolean  @default(true) // 퇴사자는 삭제가 아니라 비활성 — 명부에서 이름이 사라지면 "왜 지웠지"가 된다
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ── 직원 계정 + 역할 ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN // 플랫폼 운영자(개발자) — tenantId 없음
  DIRECTOR // 소장
  ACCOUNTANT // 경리
  STAFF // 직원
}

model User {
  id                String   @id @default(cuid())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  email             String   @unique
  kakaoId           String?  @unique // 카카오 로그인 연동 (최초 1회 이메일 매칭으로 연결)
  passwordHash      String
  name              String
  title             String? // 직책 (표시용 자유 입력: 과장, 전기과장, 경비반장 등)
  role              Role     @default(STAFF)
  createdAt         DateTime @default(now())
  // 비밀번호를 바꾼 시각 — 이 시각 이전에 발급된 세션 토큰은 무효(탈취 세션 차단)
  passwordChangedAt DateTime @default(now())
  /// 가입 시 약관·개인정보 수집 동의 시각(증적). 셀프 가입자만 찍힌다 —
  /// 마스터가 발급한 직원 계정은 null(동의 주체가 본인이 아니라 기록하지 않는다).
  /// ponytail: 약관 버전 추적 없음 — 약관을 실질 변경하는 날 versionAt 칼럼으로 올릴 것
  termsAgreedAt     DateTime?

  documents      Document[]
  notifications  Notification[]
  passwordResets PasswordReset[]

  @@index([tenantId])
}

/// 비밀번호 셀프 재설정 링크. 토큰 자체가 PK — 조회는 항상 토큰으로만 한다.
/// onDelete: Cascade — 직원 삭제·단지 탈퇴가 이 행 때문에 실패하지 않게 DB에 맡긴다.
model PasswordReset {
  token     String    @id // sha256 해시 — 평문 토큰은 메일 링크로만 나간다(hashResetToken)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // 1회용 — 사용하면 채워지고, 재발급 시 미사용 토큰도 여기로 무효화한다
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── 모듈 레지스트리 + 단지별 구독 ────────────────────────────

model Module {
  id          String  @id // slug: "dunning", "notice" ...
  name        String
  description String
  icon        String // lucide 아이콘 이름
  route       String // "/modules/dunning"
  price       Int // 월 구독료(원)
  trialDays   Int     @default(30) // 무료 체험 표준 기간 — 셀프 구독 시 전 단지 동일 적용
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  subscriptions TenantModule[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

model TenantModule {
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  moduleId     String
  module       Module             @relation(fields: [moduleId], references: [id])
  status       SubscriptionStatus @default(ACTIVE)
  // 무료 체험: null=정식 구독 / 미래=체험 중 / 과거=체험 만료.
  // enum에 TRIAL을 넣으면 기존 status:ACTIVE 조건이 전부 체험 단지를 빠뜨리고,
  // 만료를 돌려줄 크론도 필요해진다. 타임스탬프는 읽는 시점 비교로 끝난다.
  trialEndsAt  DateTime?
  subscribedAt DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@id([tenantId, moduleId])
}

// ── 전 단지 공지 배너 (관리자 발송) ──────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  message     String
  target      String    @default("ALL") // src/lib/announcements.ts 의 AnnouncementTarget
  targetValue String? // MODULE·MODULE_NOT이면 moduleId, TENANTS면 단지 id 목록(쉼표 구분)
  /// 배너에 붙는 "자세히 보기" 링크(선택). 별도 배너 시스템을 만들지 않고
  /// 공지에 컬럼 하나를 더한 이유는 대상 타게팅 규칙을 두 벌 유지하지 않기 위해서다.
  linkUrl     String?
  linkLabel   String?
  startsAt    DateTime  @default(now()) // 게시 시작 — 미래면 "예약"
  endsAt      DateTime? // 게시 종료 (null이면 무기한)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ── 운영자 감사 로그 ─────────────────────────────────────────

/// 운영자가 남의 단지에 한 일을 남긴다. **관계(FK)를 걸지 않았다** —
/// 단지나 계정이 삭제돼도 "누가 무엇을 했는지"는 남아야 하는 게 감사 로그의 목적이다.
/// 그래서 이름도 그 시점 값을 복사해 둔다.
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String // src/lib/admin-log.ts 의 AdminAction
  tenantId   String?
  tenantName String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId])
}

// ── 고객 문의 (단지 → 운영자) ────────────────────────────────

model Inquiry {
  id         String    @id @default(cuid())
  tenantId   String? // null = 아직 가입 전 (무료 체험 신청)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  category   String // "기능 문의" | "구독" | "계정" | "결제" | "체험 신청"
  title      String // 문의 본문. 체험 신청이면 단지명(담당자)
  contact    String? // 옛 체험 신청 연락처 — 전화 응대를 없애 새 문의는 쓰지 않는다
  status     String    @default("open") // open(답변 대기) | answered(답변 완료)
  answer     String? // 운영자 답변 본문 — 사용자가 문의 내역에서 펼쳐 읽는다
  answeredAt DateTime?
  fromPath   String? // 문의를 남긴 화면 경로 — "어디서 그러셨어요?"를 되묻지 않으려고
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// ── 공통 문서 저장소 ─────────────────────────────────────────

model Document {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  moduleId    String? // 생성한 모듈 slug (코어 생성 문서는 null)
  docNo       String? // 문서번호: "공지-2026-0003" (종류·연도별 순번)
  type        String // "dunning_letter" | "notice" | "contract" | "minutes" | "approval" ...
  title       String
  content     String    @default("")
  attachments Json? // [{ name, url }]
  /// 모듈별 구조화 데이터 — 기안·품의는 폼 입력 + LLM 출력 원본을 보관한다.
  /// 재편집, 공고문 자동 파생, 후속 문서(완료보고·지출결의) 필드 상속의 원천.
  meta        Json?
  /// 파생 문서(공고문·완료보고·지출결의)의 원본 문서 id. 살아 있는 파생본의 중복은
  /// 아래 @@unique가 막는다(더블클릭·동시 요청) — 폐기(void)하면 이 칸을 비워
  /// 재생성을 연다. 이력·역링크 표시는 meta.sourceDocId가 계속 담당한다.
  sourceDocId String?
  status      String    @default("draft")
  dueDate     DateTime? // 기한 — 계약 만료일, 점검 예정일 등 (할 일 위젯이 사용)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  approvalSteps   ApprovalStep[]
  attachmentFiles DocumentAttachment[]
  dunningEntries  DunningEntry[]

  // 공문서 번호는 단지 안에서 유일해야 한다 — 채번이 겹치면 DB가 막는다
  @@unique([tenantId, docNo])
  // 원본 하나에 살아 있는 파생본은 종류별 한 장 — 검사(find)는 경합에 진다
  @@unique([type, sourceDocId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

// ── 결재 단계 (기안·품의 모듈, 이후 전자결재 전 모듈이 공유) ──

/// 문서 상신 시 결재선 스냅샷으로 생성된다. 순차 진행 — order가 낮은 단계부터.
/// 내부 결재자는 userId, 외부(회장·감사)는 이름 스냅샷 + 서명 토큰으로 참여한다.
/// 스냅샷인 이유: 결재 진행 중 결재선 설정이 바뀌어도 이미 상신된 문서는 영향받지 않아야 한다.
model ApprovalStep {
  id             String    @id @default(cuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order          Int // 1부터. 같은 문서 안에서 유일
  userId         String? // 내부 결재자 — 삭제된 직원의 단계는 이름 스냅샷으로 남는다 (FK 안 건다)
  /// 외부 결재자 역할 — "CHAIR"(입주자대표회장) | "AUDITOR"(감사). 내부 결재자는 null
  externalRole   String?
  name           String // 결재자 이름 스냅샷 (표시·감사 목적 — 계정이 삭제돼도 결재란은 남아야 한다)
  /// 외부 결재자 서명 링크 토큰 — 차례가 됐을 때 발급, 만료·1회용 (PasswordReset과 같은 규칙)
  token          String?   @unique
  tokenExpiresAt DateTime?
  status         String    @default("waiting") // waiting(차례 전) | pending(결재 차례) | approved | rejected
  comment        String? // 승인·반려 의견
  actedAt        DateTime?
  /// 외부(토큰) 서명의 증적: { ip, ua, typedName }. 링크는 카톡으로 전달되므로
  /// "누가 눌렀는가"를 토큰만으로는 증명할 수 없다 — 감사 대응용 기록.
  /// 본인인증이 아니다(SMS OTP는 발송 인프라 도입 후 별건).
  signature      Json?

  @@unique([documentId, order])
  @@index([userId, status])
}

// ── 알림 센터 (사용자별 fan-out) ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "contract_expiry" | "approval_request" | "inspection_due" ...
  title     String
  body      String?
  link      String? // 클릭 시 이동 경로
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// 결재 문서의 실물 증빙 — 견적서 사진·PDF. 파일 스토리지가 없어 DB에 담는다.
/// Document.attachments(Json)와 다르다: 거기는 목록 문구, 여기는 파일 본문.
model DocumentAttachment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// meta.quotes 배열 위치 — 어느 업체의 견적서인가. null = 문서 단위 첨부(입찰 산출근거 등)
  quoteIndex Int?
  name       String
  mime       String
  size       Int
  /// 결재 당시 파일의 지문 — 사후 위변조 검증용. data를 비워도 남는다
  sha256     String
  /// 문서 폐기(void) 시 null — 이름·해시는 기록으로 남고 용량만 회수
  data       Bytes?
  createdAt  DateTime @default(now())

  @@index([documentId])
}
